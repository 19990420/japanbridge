{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/farm", "destination": "/#farm", "permanent": true },
    { "source": "/farm/", "destination": "/#farm", "permanent": true },
    { "source": "/farms", "destination": "/#farm", "permanent": true },
    { "source": "/farms/moriuchi", "destination": "/#farm", "permanent": true },
    { "source": "/farms/moriuchi/", "destination": "/#farm", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
